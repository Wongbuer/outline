# Dex OIDC for Outline — GitHub and Gitee (no local passwords)
issuer: https://docs.zengxjlab.org/dex

storage:
  type: memory

web:
  http: 0.0.0.0:5556

telemetry:
  http: 0.0.0.0:5558

staticClients:
  - id: outline
    redirectURIs:
      - "https://docs.zengxjlab.org/auth/oidc.callback"
    name: Outline
    secret: ${DEX_CLIENT_SECRET}

connectors:
  - type: github
    id: github
    name: GitHub
    config:
      clientID: ${GITHUB_CLIENT_ID}
      clientSecret: ${GITHUB_CLIENT_SECRET}
      redirectURI: https://docs.zengxjlab.org/dex/callback

  - type: oauth
    id: gitee
    name: Gitee
    config:
      clientID: ${GITEE_CLIENT_ID}
      clientSecret: ${GITEE_CLIENT_SECRET}
      redirectURI: https://docs.zengxjlab.org/dex/callback
      tokenURL: http://gitee-userinfo:3000/token
      authorizationURL: https://gitee.com/oauth/authorize
      userInfoURL: http://gitee-userinfo:3000/userinfo
      scopes:
        - user_info
        - emails
      userIDKey: id
      claimMapping:
        userNameKey: name
        preferredUsernameKey: login
        emailKey: email
        emailVerifiedKey: email_verified

oauth2:
  skipApprovalScreen: true
