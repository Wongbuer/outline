# Dex OIDC for Outline — GitHub login only (no local passwords)
issuer: https://docs.zengxjlab.org/dex

storage:
  type: memory

web:
  http: 0.0.0.0:5556

telemetry:
  http: 0.0.0.0:5558

staticClients:
  - id: outline
    redirectURIs:
      - "https://docs.zengxjlab.org/auth/oidc.callback"
    name: Outline
    secret: ${DEX_CLIENT_SECRET}

connectors:
  - type: github
    id: github
    name: GitHub
    config:
      clientID: ${GITHUB_CLIENT_ID}
      clientSecret: ${GITHUB_CLIENT_SECRET}
      redirectURI: https://docs.zengxjlab.org/dex/callback

oauth2:
  skipApprovalScreen: true
