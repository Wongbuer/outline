# Copy to .env on the server and fill in secrets.
# Domain: docs.zengxjlab.org

OUTLINE_IMAGE=ghcr.io/wongbuer/outline:latest
DEX_IMAGE=ghcr.io/wongbuer/dex-gitee:v2.41.1-1

NODE_ENV=production
SECRET_KEY=replace-with-openssl-rand-hex-32
UTILS_SECRET=replace-with-openssl-rand-hex-32

DATABASE_URL=postgres://outline:replace-postgres-password@postgres:5432/outline
PGSSLMODE=disable
POSTGRES_PASSWORD=replace-postgres-password
REDIS_URL=redis://redis:6379

URL=https://docs.zengxjlab.org
PORT=3000
FORCE_HTTPS=true

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Dex OIDC (GitHub and Gitee)
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=replace-dex-client-secret
OIDC_AUTH_URI=https://docs.zengxjlab.org/dex/auth
OIDC_TOKEN_URI=http://dex:5556/dex/token
OIDC_USERINFO_URI=http://dex:5556/dex/userinfo
OIDC_LOGOUT_URI=https://docs.zengxjlab.org/dex/logout
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=GitHub/Gitee
OIDC_SCOPES="openid profile email"

# Used by render-dex-config.sh / compose entry for Dex
DEX_CLIENT_SECRET=replace-dex-client-secret
DEX_CONFIG_GID=1001
GITHUB_CLIENT_ID=replace-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-github-oauth-app-client-secret
GITEE_CLIENT_ID=replace-gitee-oauth-app-client-id
GITEE_CLIENT_SECRET=replace-gitee-oauth-app-client-secret

ENABLE_UPDATES=false
DEFAULT_LANGUAGE=zh_CN
